# Clean URLs: /about serves about.html, / serves index.html.
# Works for any page: adding n.html makes /n available automatically.
DirectoryIndex index.html
Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  # If the site lives in a subfolder (e.g. htdocs/vertive), set: RewriteBase /vertive/

  # /index.html -> /
  RewriteCond %{THE_REQUEST} \s/+(?:[^?\s]*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ $1 [R=301,L,NC]

  # /about.html -> /about (old links, bookmarks, search results)
  RewriteCond %{THE_REQUEST} \s/+[^?\s]+\.html[\s?] [NC]
  RewriteRule ^(.+)\.html$ $1 [R=301,L,NC]

  # /about/ -> /about (a trailing slash would break relative asset paths)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ $1 [R=301,L]

  # /about -> about.html (internal, URL stays clean)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>
